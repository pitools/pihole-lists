#!/usr/bin/env bash

locales=(zh-cn zh ru de en fr it es pt ua kz pl cz lv 'fi' gr hu sk ro mk nl tr kr jp in ar il id bg rt)
list_names=(18plus)

# shellcheck disable=SC2034
split() {
    local -n arr=$1
    local delim=$2
    shift 2
    local IFS="$delim"
    read -ra arr <<< "$*"
}

print_domain_with_locales() {
    for locale in "${locales[@]}"; do
        echo "$locale.$1"
    done
}

transform_line() {
    local parts=()
    split parts " " "$1"

    read -r domain <<< "${parts[0]}"
    read -r second_part <<< "${parts[1]}"

    echo "$domain"

    local tags=()
    split tags "," "$second_part"

    for tag in "${tags[@]}"; do
        if [[ "$tag" == "@langs" ]]; then
            print_domain_with_locales "$domain"
            continue
        fi

        echo "$tag.$domain"
    done
}

for list in "${list_names[@]}"; do
    while read -r line; do
      transform_line "$line"
    done < "src/$list.source" > "lists/$list.list"
done
