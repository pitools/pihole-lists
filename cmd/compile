#!/usr/bin/env bash

# Compiles ./src files into ./lists directory by
# expending the domain list.

source cmd/config

print_domain_with_locales() {
    for locale in "${LOCALES[@]}"; do
        echo "$locale.$1"
    done
}

transform_line() {
    local parts=()
    split parts " " "$1"

    read -r domain <<< "${parts[0]}"
    read -r second_part <<< "${parts[1]}"

    echo "$domain"

    local tags=()
    split tags "," "$second_part"

    for tag in "${tags[@]}"; do
        if [[ "$tag" == "@langs" ]]; then
            print_domain_with_locales "$domain"
            continue
        fi

        echo "$tag.$domain"
    done
}

for list in "${LIST_NAMES[@]}"; do
    source_file="src/$list.source"
    output_file="lists/$list.list"
    source_lines="$(wc -l "$source_file" | awk '{ print $1 }')"

    echo "⌛ Transforming $source_lines entries. $source_file -> $output_file..."

    while read -r line; do
      transform_line "$line"
    done < "$source_file" > "$output_file"

    output_lines="$(wc -l "$output_file" | awk '{ print $1 }')"
    echo "✅ Done: $output_lines domains are ready!"
done
