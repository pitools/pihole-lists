#!/usr/bin/env bash

export LOCALES=(zh-cn zh ru de en fr it es pt ua kz pl cz lv 'fi' gr hu sk ro mk nl tr kr jp in ar il id bg rt)
export LIST_NAMES=(18plus)

# shellcheck disable=SC2034
split() {
    local -n arr=$1
    local delim=$2
    shift 2
    local IFS="$delim"
    read -ra arr <<< "$*"
}
